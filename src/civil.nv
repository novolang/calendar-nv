// civil.nv — the types, and the questions a caller asks a date that do
// not involve moving it.
//
// Civil time is time with no zone attached, and it is the subject of
// this package.  `2026-03-15T09:00` is a civil date-time.  It says what
// a wall clock reads, and it does not say which wall.  Turning it into
// an instant needs a zone, and a zone needs a clock or a database.
// Both of those are effects, so they belong to `chrono-nv`, and
// everything here is arithmetic over integers a caller already holds.
//
// The types are named `Civil*`.  chrono calls them `NaiveDate`,
// `NaiveTime` and `NaiveDateTime`, and the obvious ports would be
// `Date`, `Time` and `DateTime`.  `Date` is not available.  The
// standard library declares `struct Date`, `struct Duration` and
// `struct Instant`, and a package that redeclares one is refused with
// E2000 before it compiles a line.  The family therefore takes the
// second standard name for the same idea, civil time, as in Howard
// Hinnant's algorithms and the C++ proposal that named them.  All three
// take it, rather than two of them taking the names that were free.
//
// The calendar is proleptic Gregorian, without exception.  Year 1 is
// year 1, year 0 exists, year -1 is 2 BC, and the Julian calendar is
// not modelled anywhere.  This is chrono's rule and Python's, and it
// is the only rule under which the difference between two dates is a
// subtraction rather than a lookup.
//
// Every constructor validates.  `date(2023, 2, 29)` is an `Err` rather
// than the 1st of March.  A library that normalises silently turns a
// typo into a wrong answer nobody can find later.

// A day on the proleptic Gregorian calendar, with no zone and no time.
//
// The fields are what the caller wrote and what a formatter prints;
// the epoch-day form is the one arithmetic uses, and `epoch_day` is
// how to get it.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.date(2026, 3, 15)
//         Ok(d)  => println("${d.year}-${d.month}-${d.day}")
//         Err(_) => println("not a date")
// ```
pub @value
struct CivilDate
    // The proleptic Gregorian year.  Negative years are astronomical:
    // `0` is 1 BC and `-1` is 2 BC, which is what makes year
    // arithmetic a subtraction.
    year: Int
    // `1 ..= 12`.
    month: Int
    // `1 ..= 31`, and no more than the month and year allow.
    day: Int

// A time of day, with no zone and no date.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.time_of(9, 30, 0, 0)
//         Ok(t)  => println("${t.hour}:${t.minute}")
//         Err(_) => println("not a time")
// ```
pub @value
struct CivilTime
    // `0 ..= 23`.  There is no 24:00.  A caller who means the end of
    // the day means midnight of the next one, and which of the two to
    // write is the caller's decision.
    hour: Int
    // `0 ..= 59`.
    minute: Int
    // `0 ..= 59`.  Never 60: see `CalError.TimeOutOfRange`.
    second: Int
    // `0 ..= 999_999_999`.  Nanoseconds rather than a `Float`.
    // Fifty-two bits of mantissa resolve to about 0.2 µs around the
    // present day, which is coarser than this field.
    nano: Int

// A date and a time of day, with no zone.
//
// ```novo
// use civil
//
// fn main() [io]
//     let d = civil.date(2026, 3, 15)!
//     let t = civil.time_of(9, 30, 0, 0)!
//     let dt = civil.datetime(d, t)
//     println("${dt.date.day} at ${dt.time.hour}")
// ```
pub @value
struct CivilDateTime
    // The day.
    date: CivilDate
    // The time of day on it.
    time: CivilTime

// A day of the week.
//
// Monday first, because ISO 8601 numbers it 1 and because every week
// calculation in this package is the ISO one.  `weekday_number` is the
// conversion for a caller who needs the number.  The standard library's
// `Zoned.weekday()` answers 0 for Sunday, and the two are deliberately
// not the same function.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.weekday_number(Wed)}")     // 3
// ```
pub enum Weekday
    Mon
    Tue
    Wed
    Thu
    Fri
    Sat
    Sun

// A month of the year, as a name rather than a number.
//
// It exists so that a `match` over months is exhaustive and a caller
// cannot pass 13.  `month_number` and `month_of` cross between this
// and the `month` field, which stays an `Int` because that is what a
// parser produces and what a formatter prints.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.month_number(Feb)}")       // 2
// ```
pub enum Month
    Jan
    Feb
    Mar
    Apr
    May
    Jun
    Jul
    Aug
    Sep
    Oct
    Nov
    Dec

// A date, or the reason those three numbers are not one.
//
// `DayOutOfRange` when the day is not in that month of that year —
// including `2023-02-29`, which is why the year is in the variant —
// and `MonthOutOfRange` when the month is not `1 ..= 12`.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.date(2023, 2, 29)
//         Ok(_)  => println("2023 was not a leap year")
//         Err(_) => println("refused")
// ```
pub fn date(y: Int, m: Int, d: Int) -> Result<CivilDate, CalError>
    if m < 1 or m > 12
        return Err(MonthOutOfRange(m))
    if d < 1 or d > days_in_month(y, m)
        return Err(DayOutOfRange(y, m, d))
    Ok(CivilDate { year: y, month: m, day: d })

// A date from a year and a 1-based day of the year.
//
// chrono's `NaiveDate::from_yo_opt`.  `366` is a date in a leap year
// and `OrdinalOutOfRange` in every other.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.date_ordinal(2026, 74)
//         Ok(d)  => println("${d.month}-${d.day}")     // 3-15
//         Err(_) => println("not a day of that year")
// ```
pub fn date_ordinal(y: Int, ordinal: Int) -> Result<CivilDate, CalError>
    if ordinal < 1 or ordinal > days_in_year(y)
        return Err(OrdinalOutOfRange(y, ordinal))
    let jan1 = epoch_day(CivilDate { year: y, month: 1, day: 1 })
    Ok(date_from_epoch_day(jan1 + ordinal - 1))

// The date a signed count of days from 1970-01-01 names.
//
// Total.  Every `Int` is a date, and a negative one is a date before
// the epoch.  This function and `epoch_day` are the pair every other
// piece of date arithmetic in this package is written in terms of.  The
// conversion is Howard Hinnant's `civil_from_days`, which is the one
// the standard library's `Zoned` uses, so the two agree by construction
// rather than by testing.
//
// ```novo
// use civil
//
// fn main() [io]
//     let d = civil.date_from_epoch_day(0)
//     println("${d.year}-${d.month}-${d.day}")     // 1970-1-1
// ```
pub fn date_from_epoch_day(days: Int) -> CivilDate
    // `civil_from_days`, with the era shifted so day 0 is 1970-01-01.
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10
        mp + 3
    else
        mp - 9
    let y = yoe + era * 400
    if m <= 2
        CivilDate { year: y + 1, month: m, day: d }
    else
        CivilDate { year: y, month: m, day: d }

// Days from 1970-01-01, negative before it.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.epoch_day(civil.date(1970, 1, 2)!)}")     // 1
// ```
pub fn epoch_day(d: CivilDate) -> Int
    // `days_from_civil`.  March is the first month of the internal
    // year, which puts the leap day at the end of it and makes the
    // whole conversion a chain of divisions with no table.
    let y = if d.month <= 2
        d.year - 1
    else
        d.year
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let mp = if d.month > 2
        d.month - 3
    else
        d.month + 9
    let doy = (153 * mp + 2) / 5 + d.day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

// A time of day, or the reason those four numbers are not one.
//
// Named `time_of` rather than `time` because `time` is a standard
// library module and a call to `civil.time(…)` would read as one.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.time_of(23, 59, 60, 0)
//         Ok(_)  => println("leap seconds are not CivilTime values")
//         Err(_) => println("refused")
// ```
pub fn time_of(h: Int, minute: Int, s: Int, nano: Int) -> Result<CivilTime, CalError>
    if h < 0 or h > 23 or minute < 0 or minute > 59
        return Err(TimeOutOfRange(h, minute, s, nano))
    if s < 0 or s > 59 or nano < 0 or nano > 999999999
        return Err(TimeOutOfRange(h, minute, s, nano))
    Ok(CivilTime { hour: h, minute: minute, second: s, nano: nano })

// Midnight: `00:00:00.000000000`.
//
// The time half of a date-time built from a bare date, and the value
// `start_of_month` and friends pair a date with.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.midnight().hour}")         // 0
// ```
pub fn midnight() -> CivilTime
    CivilTime { hour: 0, minute: 0, second: 0, nano: 0 }

// A date and a time, together.
//
// Total, because both halves have already been validated.  There is no
// pair of a legal date and a legal time that is not a legal date-time.
//
// ```novo
// use civil
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!, civil.midnight())
//     println("${dt.date.year}")
// ```
pub fn datetime(d: CivilDate, t: CivilTime) -> CivilDateTime
    CivilDateTime { date: d, time: t }

// The day of the week this date falls on.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.weekday(civil.date(2026, 3, 15)!)
//         Sun => println("a Sunday")
//         _   => println("some other day")
// ```
pub fn weekday(d: CivilDate) -> Weekday
    match weekday_index(epoch_day(d))
        0 => Mon
        1 => Tue
        2 => Wed
        3 => Thu
        4 => Fri
        5 => Sat
        _ => Sun

// The weekday an ISO 8601 day-of-week number names: `1` is Monday and
// `7` is Sunday.
//
// The inverse of `weekday_number`, and the call a parser makes: an ISO
// week date and a `%u` directive both arrive as a digit.  A number
// outside `1 ..= 7` answers `Sun`, because the one caller that can
// produce one has already refused it.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.weekday_number(civil.weekday_of(3))}")     // 3
// ```
pub fn weekday_of(n: Int) -> Weekday
    match n
        1 => Mon
        2 => Tue
        3 => Wed
        4 => Thu
        5 => Fri
        6 => Sat
        _ => Sun

// The ISO 8601 number of a weekday: Monday is 1, Sunday is 7.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.weekday_number(Sun)}")     // 7
// ```
pub fn weekday_number(w: Weekday) -> Int
    match w
        Mon => 1
        Tue => 2
        Wed => 3
        Thu => 4
        Fri => 5
        Sat => 6
        Sun => 7

// This date's month, as a name.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.month_of(civil.date(2026, 3, 15)!)
//         Mar => println("March")
//         _   => println("not March")
// ```
pub fn month_of(d: CivilDate) -> Month
    match d.month
        1  => Jan
        2  => Feb
        3  => Mar
        4  => Apr
        5  => May
        6  => Jun
        7  => Jul
        8  => Aug
        9  => Sep
        10 => Oct
        11 => Nov
        _  => Dec

// The number of a month: January is 1, December is 12.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.month_number(Dec)}")       // 12
// ```
pub fn month_number(m: Month) -> Int
    match m
        Jan => 1
        Feb => 2
        Mar => 3
        Apr => 4
        May => 5
        Jun => 6
        Jul => 7
        Aug => 8
        Sep => 9
        Oct => 10
        Nov => 11
        Dec => 12

// The 1-based day of the year: 1 on the 1st of January, 365 or 366 on
// the 31st of December.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.day_of_year(civil.date(2026, 3, 15)!)}")   // 74
// ```
pub fn day_of_year(d: CivilDate) -> Int
    let jan1 = epoch_day(CivilDate { year: d.year, month: 1, day: 1 })
    epoch_day(d) - jan1 + 1

// Whether a year has 366 days, under the proleptic Gregorian rule:
// divisible by 4, except centuries, except centuries divisible by 400.
//
// Proleptic means the rule is applied to years before it was adopted.
// So `is_leap_year(1500)` is `false`, the Gregorian answer, rather than
// the Julian `true`.  Every date in this package follows that rule.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.is_leap_year(2000)}")      // true
//     println("${civil.is_leap_year(1900)}")      // false
// ```
pub fn is_leap_year(y: Int) -> Bool
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

// How many days that month of that year has: 28, 29, 30 or 31, and `0`
// for a month outside `1 ..= 12`.
//
// The answer is `0` rather than a `Result` because this is the call a
// caller makes inside a loop over `1 ..= 12`.  Threading an error
// through a question whose answer the caller already knows would be
// noise.
//
// ```novo
// use civil
//
// fn main() [io]
//     println("${civil.days_in_month(2024, 2)}")  // 29
// ```
pub fn days_in_month(y: Int, m: Int) -> Int
    if m == 2
        if is_leap_year(y)
            29
        else
            28
    elif m == 4 or m == 6 or m == 9 or m == 11
        30
    elif m >= 1 and m <= 12
        31
    else
        0

// The ISO 8601 week-numbering year and week this date is in.
//
// The week-numbering year is not the calendar year.  ISO weeks run
// Monday to Sunday and a week belongs to the year that holds its
// Thursday, so 2027-01-01 is a Friday in week 53 of 2026 and this
// answers `(2026, 53)`.  Both halves come back together, and there is
// no function that answers the week alone, because a week number read
// against the wrong year is the common mistake here.
//
// ```novo
// use civil
//
// fn main() [io]
//     let (y, w) = civil.iso_week(civil.date(2027, 1, 1)!)
//     println("${y}-W${w}")                       // 2026-W53
// ```
pub fn iso_week(d: CivilDate) -> (Int, Int)
    // The week belongs to the year of its Thursday, so the Thursday is
    // computed first and every other answer is read off it.
    let ed = epoch_day(d)
    let thursday = ed + 3 - weekday_index(ed)
    let wy = date_from_epoch_day(thursday).year
    (wy, (thursday - week1_monday(wy)) / 7 + 1)

// The date at an ISO 8601 week-numbering year, week and weekday.
//
// The inverse of `iso_week` plus `weekday`.  `WeekOutOfRange` when the
// week is not `1 ..= 52`, or is 53 in a year that has only 52 — which
// is most of them.
//
// ```novo
// use civil
//
// fn main() [io]
//     match civil.from_iso_week(2026, 53, Fri)
//         Ok(d)  => println("${d.year}-${d.month}-${d.day}")  // 2027-1-1
//         Err(_) => println("no such week")
// ```
pub fn from_iso_week(year: Int, week: Int, w: Weekday) -> Result<CivilDate, CalError>
    let start = week1_monday(year)
    let weeks = (week1_monday(year + 1) - start) / 7
    if week < 1 or week > weeks
        return Err(WeekOutOfRange(year, week))
    Ok(date_from_epoch_day(start + (week - 1) * 7 + weekday_number(w) - 1))

// `-1`, `0` or `1` as `a` is before, the same as, or after `b`.
//
// An `Int` and not a `Bool` pair, so that a caller sorting a list has
// the comparator the sort wants without writing it.
//
// ```novo
// use civil
//
// fn main() [io]
//     let a = civil.date(2026, 3, 15)!
//     let b = civil.date(2026, 4, 1)!
//     println("${civil.compare_date(a, b)}")      // -1
// ```
pub fn compare_date(a: CivilDate, b: CivilDate) -> Int
    compare_int(epoch_day(a), epoch_day(b))

// `-1`, `0` or `1` as `a` is before, the same as, or after `b`.
//
// Comparing civil date-times compares wall-clock readings.  That is a
// comparison of instants only when both readings come off the same
// wall.  There is no `is_before` in this package, because a name that
// short would hide the caveat.
//
// ```novo
// use civil
//
// fn main() [io]
//     let d = civil.date(2026, 3, 15)!
//     let x = civil.datetime(d, civil.time_of(9, 0, 0, 0)!)
//     let y = civil.datetime(d, civil.time_of(17, 0, 0, 0)!)
//     println("${civil.compare_datetime(x, y)}")  // -1
// ```
pub fn compare_datetime(a: CivilDateTime, b: CivilDateTime) -> Int
    let c = compare_date(a.date, b.date)
    if c != 0
        c
    else
        compare_int(nano_of_day(a.time), nano_of_day(b.time))

// Division rounded toward negative infinity, for a positive divisor.
//
// `/` truncates toward zero (SPEC § 13.4), which is the wrong rounding
// for a calendar.  The day before the epoch has to be day -1 rather
// than day 0.  Every call site here divides by a positive constant.
fn floor_div(a: Int, b: Int) -> Int
    let q = a / b
    if a < 0 and q * b != a
        q - 1
    else
        q

// How many days the year has: 365, or 366 when it is a leap year.
fn days_in_year(y: Int) -> Int
    if is_leap_year(y)
        366
    else
        365

// The day of the week as `0 ..= 6` with Monday 0, from an epoch day.
//
// Epoch day 0 is 1970-01-01, a Thursday, so the offset is 3.
fn weekday_index(ed: Int) -> Int
    let r = (ed + 3) % 7
    if r < 0
        r + 7
    else
        r

// The epoch day of the Monday that opens ISO week 1 of `y`.
//
// ISO 8601 § 4.3.2.2 fixes week 1 as the week holding 4 January, so
// the Monday of that week is the origin every week number counts from.
fn week1_monday(y: Int) -> Int
    let jan4 = epoch_day(CivilDate { year: y, month: 1, day: 4 })
    jan4 - weekday_index(jan4)

// `-1`, `0` or `1` as `a` is below, equal to, or above `b`.
fn compare_int(a: Int, b: Int) -> Int
    if a < b
        -1
    elif a > b
        1
    else
        0

// The nanosecond of the day a time of day names, `0 ..= 86_399_999_999_999`.
//
// One number, so comparing two times is comparing two integers rather
// than four pairs of fields in the right order.
pub fn nano_of_day(t: CivilTime) -> Int
    ((t.hour * 60 + t.minute) * 60 + t.second) * 1000000000 + t.nano
