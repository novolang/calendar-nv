// span.nv — a signed length of time, exact to the nanosecond.
//
// The type is not called `Duration`, because it cannot be.  The
// standard library declares `struct Duration`, and redeclaring it is
// E2000.  `TimeDelta` is chrono's own current name for the same type.
// `chrono::Duration` was renamed to `chrono::TimeDelta` over the same
// collision, with the old name kept as an alias, so the port takes the
// newer name and reads as a port.
//
// It is a second type beside `std.time.Duration`, and the difference is
// worth knowing before reaching for either.  The standard library's is
// microseconds in an `Int`, and it is what a monotonic clock hands
// back.  This one is whole seconds plus a nanosecond field, it is
// signed, and it is what subtracting one civil date-time from another
// gives.  `chrono-nv` is where the two meet, because that is where a
// clock is.
//
// The value is seconds plus nanoseconds rather than one number.  One
// `Int` of nanoseconds overflows at about 292 years, which is inside
// the range a calendar library is asked about.  "How long between 1800
// and today" is an ordinary question.  One `Float` of seconds loses the
// nanosecond around the present day.  Two fields cost one comparison in
// the arithmetic and answer both.
//
// The constructors keep one invariant and every operation preserves it.
// `nanos` is in `0 ..= 999_999_999`, and the sign lives entirely in
// `secs`.  So `-0.5s` is `secs = -1, nanos = 500_000_000`.  That is the
// normalisation Rust's `TimeDelta` and Go's `time.Duration` arithmetic
// produce, and the reason `as_seconds` truncates toward negative
// infinity rather than toward zero.

// A signed length of time, exact to the nanosecond.
//
// ```novo
// use span
//
// fn main() [io]
//     let d = span.hours(2)
//     println("${span.as_seconds(d)}")            // 7200
// ```
pub @value
struct TimeDelta
    // Whole seconds, signed.  The sign of the whole value.
    secs: Int
    // `0 ..= 999_999_999`, always non-negative.  The module note above
    // states the invariant.
    nanos: Int

// A length in nanoseconds.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.nanoseconds(1500000000).secs}")     // 1
// ```
pub fn nanoseconds(n: Int) -> TimeDelta
    let s = n / 1000000000
    let r = n % 1000000000
    if r < 0
        TimeDelta { secs: s - 1, nanos: r + 1000000000 }
    else
        TimeDelta { secs: s, nanos: r }

// A length in milliseconds.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.milliseconds(1500).secs}")          // 1
// ```
pub fn milliseconds(n: Int) -> TimeDelta
    let s = n / 1000
    let r = n % 1000
    if r < 0
        TimeDelta { secs: s - 1, nanos: (r + 1000) * 1000000 }
    else
        TimeDelta { secs: s, nanos: r * 1000000 }

// A length in seconds.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.seconds(90).secs}")                 // 90
// ```
pub fn seconds(n: Int) -> TimeDelta
    TimeDelta { secs: n, nanos: 0 }

// A length in minutes.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.as_seconds(span.minutes(90))}")     // 5400
// ```
pub fn minutes(n: Int) -> TimeDelta
    TimeDelta { secs: n * 60, nanos: 0 }

// A length in hours.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.as_seconds(span.hours(1))}")        // 3600
// ```
pub fn hours(n: Int) -> TimeDelta
    TimeDelta { secs: n * 3600, nanos: 0 }

// A length in days, where a day is exactly 86,400 seconds.
//
// That is the one reading available to a package with no zone in it,
// and it is not always the reading a calendar user wants.  Across a
// daylight-saving boundary a civil day is 23 or 25 hours, and this
// package cannot know where the boundaries are.  A caller who means
// "the same clock time tomorrow" wants `arith.add_days`, which moves
// the date and leaves the time alone.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.as_seconds(span.days(1))}")         // 86400
// ```
pub fn days(n: Int) -> TimeDelta
    TimeDelta { secs: n * 86400, nanos: 0 }

// Whole seconds, truncated toward negative infinity.
//
// So `as_seconds(milliseconds(-1500))` is `-2` rather than `-1`.  The
// value is `secs = -2, nanos = 500_000_000`, and this answers the
// field.  Toward negative infinity rather than toward zero, so that
// `as_seconds` reads a field off the value rather than applying a
// second rounding rule.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.as_seconds(span.milliseconds(-1500))}")   // -2
// ```
pub fn as_seconds(d: TimeDelta) -> Int
    d.secs

// The nanosecond part, `0 ..= 999_999_999`.
//
// Always non-negative, whatever the sign of the value.  The pair
// `(as_seconds, subsec_nanos)` is the representation, and reassembling
// it is `seconds(s) + nanoseconds(n)`.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.subsec_nanos(span.milliseconds(-1500))}")  // 500000000
// ```
pub fn subsec_nanos(d: TimeDelta) -> Int
    d.nanos

// The sum.
//
// `Overflow` when the seconds do not fit an `Int`, which for a length
// built from a calendar difference means the two dates were about 292
// billion years apart.  It is a `Result` anyway, because a total
// function that silently wraps is worse than one that says so.
//
// ```novo
// use span
//
// fn main() [io]
//     match span.add(span.hours(1), span.minutes(30))
//         Ok(d)  => println("${span.as_seconds(d)}")      // 5400
//         Err(_) => println("overflow")
// ```
pub fn add(a: TimeDelta, b: TimeDelta) -> Result<TimeDelta, CalError>
    let n = a.nanos + b.nanos
    let carry = if n >= 1000000000
        1
    else
        0
    let s = add_secs(a.secs, b.secs)!
    Ok(TimeDelta { secs: add_secs(s, carry)!, nanos: n - carry * 1000000000 })

// The difference, `a - b`.
//
// ```novo
// use span
//
// fn main() [io]
//     match span.sub(span.hours(1), span.minutes(90))
//         Ok(d)  => println("${span.as_seconds(d)}")      // -1800
//         Err(_) => println("overflow")
// ```
pub fn sub(a: TimeDelta, b: TimeDelta) -> Result<TimeDelta, CalError>
    let n = a.nanos - b.nanos
    let borrow = if n < 0
        1
    else
        0
    let s = sub_secs(a.secs, b.secs)!
    Ok(TimeDelta { secs: sub_secs(s, borrow)!, nanos: n + borrow * 1000000000 })

// The same length with the opposite sign.
//
// ```novo
// use span
//
// fn main() [io]
//     match span.negate(span.hours(1))
//         Ok(d)  => println("${span.as_seconds(d)}")      // -3600
//         Err(_) => println("overflow")
// ```
pub fn negate(d: TimeDelta) -> Result<TimeDelta, CalError>
    sub(TimeDelta { secs: 0, nanos: 0 }, d)

// The magnitude: the same length, never negative.
//
// ```novo
// use span
//
// fn main() [io]
//     match span.magnitude(span.minutes(-30))
//         Ok(d)  => println("${span.as_seconds(d)}")      // 1800
//         Err(_) => println("overflow")
// ```
pub fn magnitude(d: TimeDelta) -> Result<TimeDelta, CalError>
    if is_negative(d)
        negate(d)
    else
        Ok(d)

// Whether the length is less than zero.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.is_negative(span.seconds(-1))}")    // true
// ```
pub fn is_negative(d: TimeDelta) -> Bool
    d.secs < 0

// `-1`, `0` or `1` as `a` is shorter than, equal to, or longer than
// `b`.  Signed, so `-1 hour` compares less than `1 second`.
//
// ```novo
// use span
//
// fn main() [io]
//     println("${span.compare(span.hours(-1), span.seconds(1))}")  // -1
// ```
pub fn compare(a: TimeDelta, b: TimeDelta) -> Int
    let c = compare_int(a.secs, b.secs)
    if c != 0
        c
    else
        compare_int(a.nanos, b.nanos)

// The largest `Int` (SPEC § 13.2).
//
// The overflow cases below answer a `Result` rather than trapping, so
// the bound has to be a value this module can compare against.
fn int_max() -> Int
    9223372036854775807

// The most negative `Int`.
//
// Written as a subtraction because the magnitude is one above
// `int_max` and the lexer refuses a literal that large.  The minus in
// front of a number is a prefix operator rather than part of the
// number (SPEC § 13.5).
fn int_min() -> Int
    -9223372036854775807 - 1

// `a + b`, or `Overflow` when the sum leaves the range of an `Int`.
fn add_secs(a: Int, b: Int) -> Result<Int, CalError>
    if b > 0 and a > int_max() - b
        return Err(Overflow("a TimeDelta of more seconds than an Int holds"))
    if b < 0 and a < int_min() - b
        return Err(Overflow("a TimeDelta of more seconds than an Int holds"))
    Ok(a + b)

// `a - b`, or `Overflow` when the difference leaves the range.
fn sub_secs(a: Int, b: Int) -> Result<Int, CalError>
    if b < 0 and a > int_max() + b
        return Err(Overflow("a TimeDelta of more seconds than an Int holds"))
    if b > 0 and a < int_min() + b
        return Err(Overflow("a TimeDelta of more seconds than an Int holds"))
    Ok(a - b)

// `-1`, `0` or `1` as `a` is below, equal to, or above `b`.
fn compare_int(a: Int, b: Int) -> Int
    if a < b
        -1
    elif a > b
        1
    else
        0
