// arith.nv — moving a date, and the one rule that makes it ambiguous.
//
// The end-of-month rule is that rule, and it is written down here.
// "One month after the 31st of January" has no arithmetic answer,
// because February has no 31st.  Every date library picks a reading,
// and this one writes it down.
//
//     add_months(2026-01-31, 1)  ==  2026-02-28
//     add_months(2024-01-31, 1)  ==  2024-02-29
//
// The day is clamped to the last day of the target month.  That is
// chrono's `checked_add_months`, Python's `dateutil.relativedelta`, and
// what a person means by "the last of next month".  The clamp is not
// reversible.  Adding a month to the 31st and subtracting one gives the
// 28th rather than the 31st.  A caller who needs the round trip keeps
// the original date, which this package cannot do for them.
//
// The other reading rolls forward into the 3rd of March, which is what
// plain day arithmetic produces.  It is not available from this
// function.  `add_days` counts days and is the way to get it.
//
// Days and months are separate functions because a day is a fixed
// length and a month is not.  `add_days` is exact arithmetic on the
// epoch day, and `add_months` is a calendar operation with the clamp
// above.  One "add a duration" call over both is what forces a library
// to treat a month as 30 days.  `span.TimeDelta` therefore has no month
// unit, and no function here takes one.

use civil
use span

// The date `n` days later, or earlier when `n` is negative.
//
// Exact: the epoch day plus `n`.  `Overflow` when the result leaves
// the representable year range.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     match arith.add_days(civil.date(2026, 2, 27)!, 3)
//         Ok(d)  => println("${d.month}-${d.day}")        // 3-2
//         Err(_) => println("overflow")
// ```
pub fn add_days(d: CivilDate, n: Int) -> Result<CivilDate, CalError>
    if n < -day_span() or n > day_span()
        return Err(Overflow("a count of days beyond the range of years"))
    in_range(civil.date_from_epoch_day(civil.epoch_day(d) + n))

// The date `n` months later, with the day clamped to the last day of
// the target month.
//
// The rule is at the top of this module.  `2026-01-31` plus one month
// is `2026-02-28`, and the operation is not reversible.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     match arith.add_months(civil.date(2026, 1, 31)!, 1)
//         Ok(d)  => println("${d.month}-${d.day}")        // 2-28
//         Err(_) => println("overflow")
// ```
pub fn add_months(d: CivilDate, n: Int) -> Result<CivilDate, CalError>
    if n < -12 * day_span() / 30 or n > 12 * day_span() / 30
        return Err(Overflow("a count of months beyond the range of years"))
    let total = d.year * 12 + d.month - 1 + n
    let y = floor_div(total, 12)
    let m = total - y * 12 + 1
    let last = civil.days_in_month(y, m)
    let day = if d.day > last
        last
    else
        d.day
    in_range(CivilDate { year: y, month: m, day: day })

// The date `n` years later, with the same clamp: the 29th of February
// plus one year is the 28th.
//
// `add_months(d, 12 * n)` by definition, under a separate name because
// that is what the call site means.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     match arith.add_years(civil.date(2024, 2, 29)!, 1)
//         Ok(d)  => println("${d.month}-${d.day}")        // 2-28
//         Err(_) => println("overflow")
// ```
pub fn add_years(d: CivilDate, n: Int) -> Result<CivilDate, CalError>
    if n < -day_span() / 300 or n > day_span() / 300
        return Err(Overflow("a count of years beyond the range of years"))
    add_months(d, n * 12)

// The date-time a length of time later, or earlier when the length is
// negative.
//
// Exact seconds and nanoseconds, with no clamping, because a
// `span.TimeDelta` has no months in it.  A day here is 86,400 seconds.
// This package has no zone and therefore no daylight-saving boundary to
// be short or long across.
//
// ```novo
// use arith
// use civil
// use span
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!,
//                             civil.time_of(23, 30, 0, 0)!)
//     match arith.add_delta(dt, span.hours(1))
//         Ok(x)  => println("${x.date.day} ${x.time.hour}")   // 16 0
//         Err(_) => println("overflow")
// ```
pub fn add_delta(dt: CivilDateTime, d: TimeDelta) -> Result<CivilDateTime, CalError>
    let moved = span.as_seconds(d)
    if moved < -second_span() or moved > second_span()
        return Err(Overflow("a length of time beyond the range of years"))
    // Both nanosecond fields are non-negative, so their sum carries
    // upwards and never borrows.
    let nanos = civil.nano_of_day(dt.time) + span.subsec_nanos(d)
    let secs = civil.epoch_day(dt.date) * 86400 + moved + nanos / 1000000000
    let day = floor_div(secs, 86400)
    let sod = secs - day * 86400
    let t = civil.time_of(sod / 3600, sod / 60 % 60, sod % 60, nanos % 1000000000)!
    Ok(civil.datetime(in_range(civil.date_from_epoch_day(day))!, t))

// Whole days from `a` to `b`, negative when `b` is earlier.
//
// Exact, because a day between two dates is exactly a day.  It is the
// difference operation with no caveats, so it answers an `Int` rather
// than a `Result`.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     let a = civil.date(2026, 1, 1)!
//     let b = civil.date(2026, 3, 1)!
//     println("${arith.days_between(a, b)}")      // 59
// ```
pub fn days_between(a: CivilDate, b: CivilDate) -> Int
    civil.epoch_day(b) - civil.epoch_day(a)

// Whole months from `a` to `b`, truncated toward zero.
//
// "Whole" is the caveat, and it is the reason this is not the inverse
// of `add_months`.  From the 31st of January to the 28th of February is
// zero months, because the 28th is not yet a month later by the day
// number, even though `add_months` maps the one to the other.  A
// difference that answered one there could be added back and land
// somewhere else.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     let a = civil.date(2026, 1, 31)!
//     let b = civil.date(2026, 2, 28)!
//     println("${arith.months_between(a, b)}")    // 0
// ```
pub fn months_between(a: CivilDate, b: CivilDate) -> Int
    let months = (b.year - a.year) * 12 + b.month - a.month
    if months > 0 and b.day < a.day
        months - 1
    elif months < 0 and b.day > a.day
        months + 1
    else
        months

// The exact length of time from `a` to `b`, negative when `b` is
// earlier.
//
// Seconds and nanoseconds, with no months in it.  `months_between` is
// the calendar reading of the same question.
//
// ```novo
// use arith
// use civil
// use span
//
// fn main() [io]
//     let d = civil.date(2026, 3, 15)!
//     let a = civil.datetime(d, civil.time_of(9, 0, 0, 0)!)
//     let b = civil.datetime(d, civil.time_of(17, 30, 0, 0)!)
//     match arith.between(a, b)
//         Ok(x)  => println("${span.as_seconds(x)}")      // 30600
//         Err(_) => println("overflow")
// ```
pub fn between(a: CivilDateTime, b: CivilDateTime) -> Result<TimeDelta, CalError>
    let days = civil.epoch_day(b.date) - civil.epoch_day(a.date)
    let nanos = civil.nano_of_day(b.time) - civil.nano_of_day(a.time)
    span.add(span.days(days), span.nanoseconds(nanos))

// The first day of this date's month.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     println("${arith.start_of_month(civil.date(2026, 3, 15)!).day}")   // 1
// ```
pub fn start_of_month(d: CivilDate) -> CivilDate
    CivilDate { year: d.year, month: d.month, day: 1 }

// The last day of this date's month: the 28th, 29th, 30th or 31st.
//
// The call the clamp in `add_months` is written in terms of, exposed
// because "the last of the month" is a thing invoices are dated.
//
// ```novo
// use arith
// use civil
//
// fn main() [io]
//     println("${arith.end_of_month(civil.date(2024, 2, 1)!).day}")      // 29
// ```
pub fn end_of_month(d: CivilDate) -> CivilDate
    CivilDate { year: d.year, month: d.month,
                day: civil.days_in_month(d.year, d.month) }

// One day more than the calendar this package represents holds.
//
// A count larger than this leaves the year range whatever date it
// starts from, so it is refused before the addition rather than after.
// The addition itself would trap on integer overflow, and a trap is not
// the `Overflow` a caller asked to be told about.
fn day_span() -> Int
    400000000000

// The same bound in seconds, for the one operation that moves a
// date-time rather than a date.
fn second_span() -> Int
    day_span() * 86400

// Division rounded toward negative infinity, for a positive divisor.
// It is the same rule `civil` applies, and it is private because it is
// arithmetic rather than part of what the package offers.
fn floor_div(a: Int, b: Int) -> Int
    let q = a / b
    if a < 0 and q * b != a
        q - 1
    else
        q

// The date, or `Overflow` naming the range it left.
//
// Every operation in this module ends here, so the range is stated
// once and the message is the same wherever a caller ran out of years.
fn in_range(d: CivilDate) -> Result<CivilDate, CalError>
    if d.year < -999999999 or d.year > 999999999
        return Err(Overflow("a year outside -999_999_999 ..= 999_999_999"))
    Ok(d)
