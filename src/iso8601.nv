// iso8601.nv — the two interchange formats, read and written.
//
// ISO 8601 IS A LARGE STANDARD AND THIS IS A SUBSET, named here so a
// reader does not have to discover it by failing:
//
//   accepted     `2026-03-15`, `09:30`, `09:30:00`, `09:30:00.5`,
//                `2026-03-15T09:30:00`, `2026-074` (ordinal),
//                `2026-W11-7` (ISO week date), a lower-case `t`,
//                a space in place of the `T`, fractional seconds to
//                nine digits
//   refused      basic format without separators (`20260315`), a
//                24-hour week-date year alone (`2026-W11`), intervals,
//                recurring intervals, a comma as the decimal mark,
//                anything after the value
//
// RFC 3339 is the smaller, stricter profile of the same syntax with an
// offset that is always present, and it is what an API actually sends.
// It gets its own pair of functions because the offset is part of the
// value there and is not part of a `CivilDateTime`: the parse returns
// the offset beside the date-time and the caller decides what to do
// with it.  Applying it is `chrono-nv`'s job, because it takes a zone
// to know what applying it means.
//
// LEAP SECONDS.  RFC 3339 § 5.7 permits `:60` and this parser ACCEPTS
// it, mapping it onto the first instant of the following minute — the
// same reading `std.time`'s `Zoned.parse_rfc3339` takes, so the two
// agree on every string.  `civil.time_of(23, 59, 60, 0)` is still an
// error: the value does not exist, and only a parser has the context
// to turn text that says it does into the value that was meant.
//
// WHAT `format` GUARANTEES.  `parse(format(x)) == x` for every value
// this package can build.  The reverse — `format(parse(s)) == s` — is
// not promised and cannot be: `09:30`, `09:30:00` and `09:30:00.000`
// are one value with three spellings, and output picks one.

use civil
use span

// A calendar date from `YYYY-MM-DD`, an ordinal date from `YYYY-DDD`,
// or an ISO week date from `YYYY-Www-D`.
//
// Which of the three is decided by the shape after the year, so a
// caller does not choose a parser; there is one date syntax and three
// ways to write a day in it.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_date("2026-03-15")
//         Ok(d)  => println("${d.year}-${d.month}-${d.day}")
//         Err(_) => println("not a date")
// ```
pub fn parse_date(s: Str) -> Result<CivilDate, CalError>
    todo("calendar-nv.parse_date")

// A time of day from `HH:MM`, `HH:MM:SS` or `HH:MM:SS.fffffffff`.
//
// Fractional digits past the ninth are refused rather than dropped: a
// string with more precision than this type has is a string the caller
// should know about, and silently truncating it is how a round trip
// stops being one.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_time("09:30:00.5")
//         Ok(t)  => println("${t.nano}")                  // 500000000
//         Err(_) => println("not a time")
// ```
pub fn parse_time(s: Str) -> Result<CivilTime, CalError>
    todo("calendar-nv.parse_time")

// A date and time from `<date>T<time>`, with a lower-case `t` or a
// single space also accepted as the separator.
//
// No offset: a string with one is RFC 3339 and belongs to
// `parse_rfc3339`, which returns the offset instead of discarding it.
// A trailing `Z` here is `TrailingText`, and that refusal is on
// purpose — silently ignoring a `Z` is how a UTC timestamp becomes a
// local one.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_datetime("2026-03-15T09:30:00")
//         Ok(dt) => println("${dt.date.day} ${dt.time.hour}")
//         Err(_) => println("not a date-time")
// ```
pub fn parse_datetime(s: Str) -> Result<CivilDateTime, CalError>
    todo("calendar-nv.parse_datetime")

// An RFC 3339 timestamp: the civil date-time as written, and the
// offset in minutes east of UTC.
//
// The pair, rather than a normalised UTC value, because the offset is
// information the sender chose to include — `+02:00` says which wall
// the reading came off — and a library that folded it away would make
// `format_rfc3339(parse_rfc3339(s))` print a different string from the
// one it read.
//
// `Z` and `z` are offset `0`.  `-00:00` means "offset unknown" (§ 4.3)
// and is also `0`; this package does not model the distinction, and
// neither does `std.time`.  `:60` is accepted as a leap second and
// lands on the following minute.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_rfc3339("2026-03-15T09:30:00+02:00")
//         Ok((dt, off)) => println("${dt.time.hour} at ${off}")   // 9 at 120
//         Err(_)        => println("not a timestamp")
// ```
pub fn parse_rfc3339(s: Str) -> Result<(CivilDateTime, Int), CalError>
    todo("calendar-nv.parse_rfc3339")

// `YYYY-MM-DD`, zero-padded.
//
// A year outside `0 ..= 9999` is printed with as many digits as it
// needs and a leading `-` when negative, which is outside RFC 3339 and
// is what keeps `parse_date(format_date(d))` an identity for every
// value this package can build.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     println(iso8601.format_date(civil.date(2026, 3, 15)!))     // 2026-03-15
// ```
pub fn format_date(d: CivilDate) -> Str
    todo("calendar-nv.format_date")

// `HH:MM:SS`, plus `.fffffffff` when the nanosecond field is not zero.
//
// The fraction is printed with as many digits as it needs in groups of
// three — `.5` prints as `.500`, `.000000001` as `.000000001` — which
// is what RFC 3339 § 5.6's `time-secfrac` allows and what every other
// implementation does.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     println(iso8601.format_time(civil.time_of(9, 30, 0, 0)!))  // 09:30:00
// ```
pub fn format_time(t: CivilTime) -> Str
    todo("calendar-nv.format_time")

// `<date>T<time>`, with the upper-case `T`.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!,
//                             civil.time_of(9, 30, 0, 0)!)
//     println(iso8601.format_datetime(dt))        // 2026-03-15T09:30:00
// ```
pub fn format_datetime(dt: CivilDateTime) -> Str
    todo("calendar-nv.format_datetime")

// `<date>T<time><offset>`, where the offset is `Z` for zero and
// `+HH:MM` or `-HH:MM` otherwise.
//
// The offset is an argument and not a field of the value, because a
// `CivilDateTime` has no zone: this function writes the timestamp a
// caller who KNOWS the offset wants to send.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!,
//                             civil.time_of(9, 30, 0, 0)!)
//     println(iso8601.format_rfc3339(dt, 120))    // 2026-03-15T09:30:00+02:00
// ```
pub fn format_rfc3339(dt: CivilDateTime, offset_min: Int) -> Str
    todo("calendar-nv.format_rfc3339")

// An ISO 8601 duration — `P3DT4H30M`, `PT1.5S`, `-PT30M` — as a
// `TimeDelta`.
//
// The subset is the fixed-length part: days, hours, minutes and
// seconds, with a fractional seconds field.  **`Y` and `M` in the date
// part are refused**, because a year and a month are not lengths of
// time and a `TimeDelta` cannot hold one.  `P1M` is `BadFormat` with
// that as the reason, rather than 30 days, which is the guess this
// package will not make.  `W` is accepted and is 7 days.
//
// ```novo
// use iso8601
// use span
//
// fn main() [io]
//     match iso8601.parse_duration("P1DT2H30M")
//         Ok(d)  => println("${span.as_seconds(d)}")      // 95400
//         Err(_) => println("not a duration")
// ```
pub fn parse_duration(s: Str) -> Result<TimeDelta, CalError>
    todo("calendar-nv.parse_duration")

// A `TimeDelta` as an ISO 8601 duration.
//
// Days, hours, minutes and seconds, with zero components omitted, a
// leading `-` for a negative length, and `PT0S` for zero.  Never `Y`
// or `M`, for the reason `parse_duration` refuses them.
//
// ```novo
// use iso8601
// use span
//
// fn main() [io]
//     println(iso8601.format_duration(span.minutes(150)))        // PT2H30M
// ```
pub fn format_duration(d: TimeDelta) -> Str
    todo("calendar-nv.format_duration")
