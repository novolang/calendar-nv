// iso8601.nv — the two interchange formats, read and written.
//
// ISO 8601 is a large standard and this module reads a subset of it.
// The subset is named here, so a reader does not have to discover it by
// failing.
//
//   accepted     `2026-03-15`, `09:30`, `09:30:00`, `09:30:00.5`,
//                `2026-03-15T09:30:00`, `2026-074` (ordinal),
//                `2026-W11-7` (ISO week date), a lower-case `t`,
//                a space in place of the `T`, fractional seconds to
//                nine digits
//   refused      basic format without separators (`20260315`), a
//                24-hour week-date year alone (`2026-W11`), intervals,
//                recurring intervals, a comma as the decimal mark,
//                anything after the value
//
// RFC 3339 is the smaller, stricter profile of the same syntax with an
// offset that is always present, and it is what an API actually sends.
// It has its own pair of functions because the offset is part of the
// value there and is not part of a `CivilDateTime`.  The parse answers
// the offset beside the date-time, and the caller decides what to do
// with it.  Applying it belongs to `chrono-nv`, because it takes a zone
// to know what applying it means.
//
// A leap second is accepted here and refused by the constructor.  RFC
// 3339 § 5.7 permits `:60`, and this parser reads it as the first
// instant of the following minute.  That is the reading `std.time`'s
// `Zoned.parse_rfc3339` takes, so the two agree on every string.
// `civil.time_of(23, 59, 60, 0)` is still an error, because the value
// does not exist.  Only a parser has the context to turn text that says
// it does into the value that was meant.
//
// `format` guarantees that `parse(format(x)) == x` for every value this
// package can build.  The reverse, `format(parse(s)) == s`, is not
// promised and cannot be.  `09:30`, `09:30:00` and `09:30:00.000` are
// one value with three spellings, and output picks one.

use arith
use civil
use scan
use span

// A calendar date from `YYYY-MM-DD`, an ordinal date from `YYYY-DDD`,
// or an ISO week date from `YYYY-Www-D`.
//
// Which of the three is decided by the shape after the year, so a
// caller does not choose a parser.  There is one date syntax, and three
// ways to write a day in it.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_date("2026-03-15")
//         Ok(d)  => println("${d.year}-${d.month}-${d.day}")
//         Err(_) => println("not a date")
// ```
pub fn parse_date(s: Str) -> Result<CivilDate, CalError>
    let (d, next) = scan_date(s, 0)!
    if next != str.len(s)
        return Err(TrailingText(next))
    Ok(d)

// A time of day from `HH:MM`, `HH:MM:SS` or `HH:MM:SS.fffffffff`.
//
// Fractional digits past the ninth are refused rather than dropped.  A
// string that carries more precision than this type holds is a string
// the caller should know about, and truncating it silently is how a
// round trip stops being one.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_time("09:30:00.5")
//         Ok(t)  => println("${t.nano}")                  // 500000000
//         Err(_) => println("not a time")
// ```
pub fn parse_time(s: Str) -> Result<CivilTime, CalError>
    let t = scan_time(s, 0)!
    if t.next != str.len(s)
        return Err(TrailingText(t.next))
    civil.time_of(t.hour, t.minute, t.second, t.nano)

// A date and time from `<date>T<time>`, with a lower-case `t` or a
// single space also accepted as the separator.
//
// No offset.  A string with one is RFC 3339 and belongs to
// `parse_rfc3339`, which answers the offset instead of discarding it.
// A trailing `Z` here is `TrailingText`, and that refusal is on
// purpose.  Ignoring a `Z` silently is how a UTC timestamp becomes a
// local one.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_datetime("2026-03-15T09:30:00")
//         Ok(dt) => println("${dt.date.day} ${dt.time.hour}")
//         Err(_) => println("not a date-time")
// ```
pub fn parse_datetime(s: Str) -> Result<CivilDateTime, CalError>
    let (dt, next) = scan_datetime(s, 0)!
    if next != str.len(s)
        return Err(TrailingText(next))
    Ok(dt)

// An RFC 3339 timestamp: the civil date-time as written, and the
// offset in minutes east of UTC.
//
// The answer is the pair rather than a normalised UTC value, because
// the offset is information the sender chose to include.  `+02:00` says
// which wall the reading came off.  A library that folded it away would
// make `format_rfc3339(parse_rfc3339(s))` print a different string from
// the one it read.
//
// `Z` and `z` are offset `0`.  `-00:00` means "offset unknown" (§ 4.3)
// and is also `0`.  This package does not model the distinction, and
// neither does `std.time`.  `:60` is accepted as a leap second and
// lands on the following minute.
//
// ```novo
// use iso8601
//
// fn main() [io]
//     match iso8601.parse_rfc3339("2026-03-15T09:30:00+02:00")
//         Ok((dt, off)) => println("${dt.time.hour} at ${off}")   // 9 at 120
//         Err(_)        => println("not a timestamp")
// ```
pub fn parse_rfc3339(s: Str) -> Result<(CivilDateTime, Int), CalError>
    let (dt, j) = scan_datetime(s, 0)!
    let sign = scan.at(s, j)
    if sign == 90 or sign == 122   // 'Z' or 'z'
        if j + 1 != str.len(s)
            return Err(TrailingText(j + 1))
        return Ok((dt, 0))
    if sign != 43 and sign != 45   // '+' or '-'
        return Err(scan.need(s, j, "an offset: 'Z', '+HH:MM' or '-HH:MM'"))
    let oh = scan.fixed(s, j + 1, 2, "a two-digit offset hour")!
    if scan.at(s, j + 3) != 58   // ':'
        return Err(scan.need(s, j + 3, "a ':' in the offset"))
    let om = scan.fixed(s, j + 4, 2, "a two-digit offset minute")!
    if oh > 23 or om > 59
        return Err(BadFormat(j + 1, "an offset of less than a day"))
    if j + 6 != str.len(s)
        return Err(TrailingText(j + 6))
    if sign == 45   // '-'
        Ok((dt, -(oh * 60 + om)))
    else
        Ok((dt, oh * 60 + om))

// `YYYY-MM-DD`, zero-padded.
//
// A year outside `0 ..= 9999` is printed with as many digits as it
// needs and a leading `-` when negative, which is outside RFC 3339 and
// is what keeps `parse_date(format_date(d))` an identity for every
// value this package can build.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     println(iso8601.format_date(civil.date(2026, 3, 15)!))     // 2026-03-15
// ```
pub fn format_date(d: CivilDate) -> Str
    "${format_year(d.year)}-${scan.pad2(d.month)}-${scan.pad2(d.day)}"

// `HH:MM:SS`, plus `.fffffffff` when the nanosecond field is not zero.
//
// The fraction is printed with as many digits as it needs in groups of
// three — `.5` prints as `.500`, `.000000001` as `.000000001` — which
// is what RFC 3339 § 5.6's `time-secfrac` allows and what every other
// implementation does.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     println(iso8601.format_time(civil.time_of(9, 30, 0, 0)!))  // 09:30:00
// ```
pub fn format_time(t: CivilTime) -> Str
    "${scan.pad2(t.hour)}:${scan.pad2(t.minute)}:${scan.pad2(t.second)}${format_fraction(t.nano)}"

// `<date>T<time>`, with the upper-case `T`.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!,
//                             civil.time_of(9, 30, 0, 0)!)
//     println(iso8601.format_datetime(dt))        // 2026-03-15T09:30:00
// ```
pub fn format_datetime(dt: CivilDateTime) -> Str
    "${format_date(dt.date)}T${format_time(dt.time)}"

// `<date>T<time><offset>`, where the offset is `Z` for zero and
// `+HH:MM` or `-HH:MM` otherwise.
//
// The offset is an argument rather than a field of the value, because a
// `CivilDateTime` has no zone.  This function writes the timestamp a
// caller who already holds the offset wants to send.
//
// ```novo
// use iso8601
// use civil
//
// fn main() [io]
//     let dt = civil.datetime(civil.date(2026, 3, 15)!,
//                             civil.time_of(9, 30, 0, 0)!)
//     println(iso8601.format_rfc3339(dt, 120))    // 2026-03-15T09:30:00+02:00
// ```
pub fn format_rfc3339(dt: CivilDateTime, offset_min: Int) -> Str
    "${format_datetime(dt)}${format_offset(offset_min)}"

// An ISO 8601 duration — `P3DT4H30M`, `PT1.5S`, `-PT30M` — as a
// `TimeDelta`.
//
// The subset is the fixed-length part.  That is days, hours, minutes
// and seconds, with a fractional seconds field.  `Y` and `M` in the
// date part are refused, because a year and a month are not lengths of
// time and a `TimeDelta` cannot hold one.  `P1M` is `BadFormat` naming
// that reason rather than 30 days, which is a guess this package does
// not make.  `W` is accepted and is 7 days.
//
// ```novo
// use iso8601
// use span
//
// fn main() [io]
//     match iso8601.parse_duration("P1DT2H30M")
//         Ok(d)  => println("${span.as_seconds(d)}")      // 95400
//         Err(_) => println("not a duration")
// ```
pub fn parse_duration(s: Str) -> Result<TimeDelta, CalError>
    let neg = scan.at(s, 0) == 45   // a leading '-'
    let i = if neg
        1
    else
        0
    if scan.at(s, i) != 80   // 'P'
        return Err(scan.need(s, i, "a 'P'"))
    let total = scan_components(s, i + 1, false, TimeDelta { secs: 0, nanos: 0 }, 0)!
    if neg
        span.negate(total)
    else
        Ok(total)

// A `TimeDelta` as an ISO 8601 duration.
//
// Days, hours, minutes and seconds, with zero components omitted, a
// leading `-` for a negative length, and `PT0S` for zero.  Never `Y`
// or `M`, for the reason `parse_duration` refuses them.
//
// ```novo
// use iso8601
// use span
//
// fn main() [io]
//     println(iso8601.format_duration(span.minutes(150)))        // PT2H30M
// ```
pub fn format_duration(d: TimeDelta) -> Str
    let secs = span.as_seconds(d)
    let nanos = span.subsec_nanos(d)
    if secs == 0 and nanos == 0
        return "PT0S"
    if secs < 0
        // The magnitude, taken a field at a time, so that the sign is
        // the only thing this branch changes.
        let borrow = if nanos > 0
            1
        else
            0
        return "-${unsigned_duration(-(secs + borrow), (1000000000 - nanos) % 1000000000)}"
    unsigned_duration(secs, nanos)

// A time of day as the scanner found it, with the offset it stopped at.
//
// The second can be 60 here and a `CivilTime`'s cannot.  A leap second
// in the text is permitted by RFC 3339 § 5.7, and only a caller that
// also holds a date can say which instant that text names.
@value
struct ClockScan
    hour: Int
    minute: Int
    second: Int
    nano: Int
    next: Int

// A date at `i`, in whichever of the three spellings is written there,
// and the offset after it.
fn scan_date(s: Str, i: Int) -> Result<(CivilDate, Int), CalError>
    let neg = scan.at(s, i) == 45   // a leading '-'
    let ds = if neg
        i + 1
    else
        i
    let de = scan.end_of_digits(s, ds)
    if de - ds < 4
        return Err(scan.need(s, ds, "a year of at least four digits"))
    let magnitude = scan.digits_value(s, ds, de)
    let year = if neg
        -magnitude
    else
        magnitude
    if scan.at(s, de) != 45   // '-'
        return Err(scan.need(s, de, "a '-' after the year"))
    if scan.at(s, de + 1) == 87   // 'W'
        return scan_week_date(s, year, de + 2)
    let ne = scan.end_of_digits(s, de + 1)
    if ne - de - 1 == 3
        return scan_ordinal_date(year, scan.digits_value(s, de + 1, ne), ne)
    if ne - de - 1 != 2
        return Err(scan.need(s, de + 1, "a month or a day of the year"))
    let month = scan.digits_value(s, de + 1, ne)
    if scan.at(s, ne) != 45   // '-'
        return Err(scan.need(s, ne, "a '-' after the month"))
    let day = scan.fixed(s, ne + 1, 2, "a two-digit day")!
    match civil.date(year, month, day)
        Ok(d)  => Ok((d, ne + 3))
        Err(e) => Err(e)

// The ordinal spelling, once the digits have been read.
fn scan_ordinal_date(year: Int, ordinal: Int, next: Int) -> Result<(CivilDate, Int), CalError>
    match civil.date_ordinal(year, ordinal)
        Ok(d)  => Ok((d, next))
        Err(e) => Err(e)

// The week spelling, `Www-D`, starting after the `W`.
fn scan_week_date(s: Str, year: Int, i: Int) -> Result<(CivilDate, Int), CalError>
    let week = scan.fixed(s, i, 2, "a two-digit ISO week")!
    if scan.at(s, i + 2) != 45   // '-'
        return Err(scan.need(s, i + 2, "a '-' after the week"))
    let n = scan.fixed(s, i + 3, 1, "a weekday digit 1-7")!
    if n < 1
        return Err(BadFormat(i + 3, "a weekday digit 1-7"))
    match civil.from_iso_week(year, week, civil.weekday_of(n))
        Ok(d)  => Ok((d, i + 4))
        Err(e) => Err(e)

// A time of day at `i`, with its fields unvalidated past the ranges
// the grammar itself fixes.
fn scan_time(s: Str, i: Int) -> Result<ClockScan, CalError>
    let h = scan.fixed(s, i, 2, "a two-digit hour")!
    if scan.at(s, i + 2) != 58   // ':'
        return Err(scan.need(s, i + 2, "a ':' after the hour"))
    let mi = scan.fixed(s, i + 3, 2, "a two-digit minute")!
    if h > 23 or mi > 59
        return Err(TimeOutOfRange(h, mi, 0, 0))
    if scan.at(s, i + 5) != 58   // ':'
        return Ok(ClockScan { hour: h, minute: mi, second: 0, nano: 0, next: i + 5 })
    let sec = scan.fixed(s, i + 6, 2, "a two-digit second")!
    if sec > 60
        return Err(TimeOutOfRange(h, mi, sec, 0))
    if scan.at(s, i + 8) != 46   // '.'
        return Ok(ClockScan { hour: h, minute: mi, second: sec, nano: 0, next: i + 8 })
    let fe = scan.end_of_digits(s, i + 9)
    if fe == i + 9
        return Err(scan.need(s, i + 9, "at least one fraction digit"))
    if fe - i - 9 > 9
        return Err(BadFormat(i + 18, "at most nine fraction digits"))
    var nano = 0
    var scale = 100000000
    for k in i + 9..fe
        nano = nano + (scan.at(s, k) - 48) * scale
        scale = scale / 10
    Ok(ClockScan { hour: h, minute: mi, second: sec, nano: nano, next: fe })

// A date, a separator and a time, with a leap second resolved.
fn scan_datetime(s: Str, i: Int) -> Result<(CivilDateTime, Int), CalError>
    let (d, j) = scan_date(s, i)!
    let sep = scan.at(s, j)
    if sep != 84 and sep != 116 and sep != 32   // 'T', 't' or a space
        return Err(scan.need(s, j, "a 'T' or a space between the date and the time"))
    let t = scan_time(s, j + 1)!
    if t.second == 60
        // RFC 3339 § 5.7: the text names a leap second, and the value
        // it names is the first instant of the following minute.
        let start = civil.datetime(d, civil.time_of(t.hour, t.minute, 0, t.nano)!)
        return Ok((arith.add_delta(start, span.minutes(1))!, t.next))
    Ok((civil.datetime(d, civil.time_of(t.hour, t.minute, t.second, t.nano)!), t.next))

// One component of a duration, folded into the length built so far.
//
// Recursive rather than a loop, because a component can fail and `!`
// carries the reason out of it.  `i` only ever moves forward, so the
// recursion is bounded by the length of the input.
fn scan_components(s: Str, i: Int, in_time: Bool, acc: TimeDelta,
                   seen: Int) -> Result<TimeDelta, CalError>
    if i >= str.len(s)
        if seen == 0
            return Err(Truncated(str.len(s)))
        return Ok(acc)
    if scan.at(s, i) == 84   // 'T'
        if in_time
            return Err(BadFormat(i, "one 'T' in a duration"))
        return scan_components(s, i + 1, true, acc, seen)
    let ne = scan.end_of_digits(s, i)
    if ne == i
        return Err(BadFormat(i, "a number before a duration designator"))
    let whole = scan.digits_value(s, i, ne)
    var nanos = 0
    var j = ne
    if scan.at(s, ne) == 46   // '.'
        let fe = scan.end_of_digits(s, ne + 1)
        if fe == ne + 1
            return Err(scan.need(s, ne + 1, "at least one fraction digit"))
        if fe - ne - 1 > 9
            return Err(BadFormat(ne + 10, "at most nine fraction digits"))
        var scale = 100000000
        for k in ne + 1..fe
            nanos = nanos + (scan.at(s, k) - 48) * scale
            scale = scale / 10
        j = fe
    let unit = scan.at(s, j)
    let scale = unit_seconds(unit, in_time)
    if scale == 0
        return Err(bad_designator(s, j, unit, in_time))
    if nanos != 0 and unit != 83   // 'S'
        return Err(BadFormat(ne + 1, "a fraction only on the seconds"))
    let part = TimeDelta { secs: whole * scale, nanos: nanos }
    scan_components(s, j + 1, in_time, span.add(acc, part)!, seen + 1)

// How many seconds one unit of a designator is, or `0` when the letter
// is not a designator this subset accepts where it stands.
//
// `Y` and `M` outside the time part answer `0` on purpose.  A year and
// a month are not lengths of time, and the caller turns that `0` into
// the refusal the module note describes.
fn unit_seconds(unit: Int, in_time: Bool) -> Int
    if in_time
        if unit == 72   // 'H'
            3600
        elif unit == 77   // 'M'
            60
        elif unit == 83   // 'S'
            1
        else
            0
    elif unit == 68   // 'D'
        86400
    elif unit == 87   // 'W'
        604800
    else
        0

// Why a byte is not a designator, in the words the caller needs.
fn bad_designator(s: Str, j: Int, unit: Int, in_time: Bool) -> CalError
    if j >= str.len(s)
        Truncated(str.len(s))
    elif not in_time and (unit == 89 or unit == 77)   // 'Y' or 'M'
        BadFormat(j, "a length of time — a year and a month are not lengths of time")
    else
        BadFormat(j, "a duration designator")

// The year as ISO 8601 writes it: four digits when it fits in four, and
// otherwise as many as it needs with a leading `-` when it is negative.
fn format_year(y: Int) -> Str
    if y < 0
        "-${format_year(-y)}"
    elif y < 10
        "000${y}"
    elif y < 100
        "00${y}"
    elif y < 1000
        "0${y}"
    else
        "${y}"

// The fraction of a second, in groups of three digits, or nothing when
// the nanosecond field is zero.
fn format_fraction(nano: Int) -> Str
    if nano == 0
        ""
    elif nano % 1000000 == 0
        ".${scan.pad_digits(nano / 1000000, 3)}"
    elif nano % 1000 == 0
        ".${scan.pad_digits(nano / 1000, 6)}"
    else
        ".${scan.pad_digits(nano, 9)}"

// `Z` for zero, and `+HH:MM` or `-HH:MM` otherwise.
fn format_offset(offset_min: Int) -> Str
    if offset_min == 0
        "Z"
    elif offset_min < 0
        "-${scan.pad2(-offset_min / 60)}:${scan.pad2(-offset_min % 60)}"
    else
        "+${scan.pad2(offset_min / 60)}:${scan.pad2(offset_min % 60)}"

// `PnDTnHnMnS` with the zero components left out, for a length that is
// not negative.
fn unsigned_duration(secs: Int, nanos: Int) -> Str
    let days = secs / 86400
    let hours = secs / 3600 % 24
    let minutes = secs / 60 % 60
    let seconds = secs % 60
    let date_part = if days == 0
        "P"
    else
        "P${days}D"
    if hours == 0 and minutes == 0 and seconds == 0 and nanos == 0
        return date_part
    var out = "${date_part}T"
    if hours != 0
        out = "${out}${hours}H"
    if minutes != 0
        out = "${out}${minutes}M"
    if seconds != 0 or nanos != 0
        out = "${out}${seconds}${format_fraction(nanos)}S"
    out
